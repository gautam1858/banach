--- /dev/null
+++ b/src/llama-ladder.h
@@ -0,0 +1,20 @@
+#pragma once
+
+#include "ggml.h"
+#include "ggml-backend.h"
+
+struct llama_model;
+
+// Banach precision ladder state owned by a llama_context (see llama_set_ladder).
+struct llama_ladder {
+    const llama_model * low = nullptr;
+    ggml_context * ctx = nullptr;
+    ggml_backend_buffer_t buf = nullptr;
+    ggml_tensor * eps = nullptr; // [n_expert, n_layer] relative error of the low copy
+    ggml_tensor * tau = nullptr; // [1]
+
+    ~llama_ladder() {
+        if (buf) ggml_backend_buffer_free(buf);
+        if (ctx) ggml_free(ctx);
+    }
+};
