+// Banach precision ladder
+
+int32_t llama_context::set_ladder(const llama_model * low, const float * eps, float tau) {
+    if (low == nullptr) {
+        if (ladder) {
+            ladder.reset();
+            sched_need_reserve = true;
+        }
+        return 0;
+    }
+    const int64_t n_layer  = model.hparams.n_layer();
+    const int64_t n_expert = model.hparams.n_expert;
+    if (n_expert <= 0) {
+        LLAMA_LOG_ERROR("%s: the model has no routed experts\n", __func__);
+        return -1;
+    }
+    if (low->arch != model.arch || low->hparams.n_layer() != model.hparams.n_layer() ||
+        low->hparams.n_expert != model.hparams.n_expert) {
+        LLAMA_LOG_ERROR("%s: the low model does not match this model\n", __func__);
+        return -1;
+    }
+    auto l = std::make_unique<llama_ladder>();
+    l->low = low;
+    ggml_init_params ip = { 2 * ggml_tensor_overhead(), nullptr, true };
+    l->ctx = ggml_init(ip);
+    l->eps = ggml_new_tensor_2d(l->ctx, GGML_TYPE_F32, n_expert, n_layer);
+    l->tau = ggml_new_tensor_1d(l->ctx, GGML_TYPE_F32, 1);
+    ggml_set_name(l->eps, "banach_ladder_eps");
+    ggml_set_name(l->tau, "banach_ladder_tau");
+    l->buf = ggml_backend_alloc_ctx_tensors_from_buft(l->ctx, ggml_backend_cpu_buffer_type());
+    if (!l->buf) {
+        LLAMA_LOG_ERROR("%s: failed to allocate the ladder buffer\n", __func__);
+        return -1;
+    }
+    std::vector<float> e((size_t) (n_layer * n_expert), 1.0f);
+    if (eps) {
+        std::copy(eps, eps + e.size(), e.begin());
+    }
+    ggml_backend_tensor_set(l->eps, e.data(), 0, e.size() * sizeof(float));
+    ggml_backend_tensor_set(l->tau, &tau, 0, sizeof(float));
+    ladder = std::move(l);
+    sched_need_reserve = true;
+    return 0;
+}
+
+void llama_context::set_ladder_tau(float tau) {
+    if (ladder && ladder->tau) {
+        ggml_backend_tensor_set(ladder->tau, &tau, 0, sizeof(float));
+    }
+}
+
+int32_t llama_set_ladder(llama_context * ctx, const llama_model * low, const float * eps, float tau) {
+    return ctx->set_ladder(low, eps, tau);
+}
+
+void llama_set_ladder_tau(llama_context * ctx, float tau) {
+    ctx->set_ladder_tau(tau);
+}
